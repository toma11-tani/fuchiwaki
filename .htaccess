# 301リダイレクト設定
# 旧HTMLファイルから新しいディレクトリ構造へのリダイレクト

# RewriteEngineを有効化
RewriteEngine On

# 不要なクエリパラメータを削除してリダイレクト（srsltid, fbclid, gclid等）
RewriteCond %{QUERY_STRING} ^(.*)(?:^|&)(?:srsltid|fbclid|gclid|utm_source|utm_medium|utm_campaign)=[^&]*(?:&(.*))?$ [NC]
RewriteRule ^(.*)$ /$1?%1%2 [R=301,L]

# /pages/ 配下のすべてのURLを /company/ にリダイレクト
RewriteCond %{REQUEST_URI} ^/pages/
RewriteRule ^pages/.* /company/? [R=301,L]

# /products/ 配下のサブパスを /products/ にリダイレクト
RewriteCond %{REQUEST_URI} ^/products/.+
RewriteRule ^products/.+ /products/? [R=301,L]

# /collections/ 配下のサブパスを /products/ にリダイレクト
RewriteCond %{REQUEST_URI} ^/collections/.+
RewriteRule ^collections/.+ /products/? [R=301,L]

# /blogs/ 配下を shop.fuchiwaki.jp/blogs/ にリダイレクト（パスを保持）
RewriteRule ^blogs/?(.*)$ https://shop.fuchiwaki.jp/blogs/$1 [R=301,L]


# ブログ記事のリダイレクト
Redirect 301 /blog-post-20260101.html /blog/2026-01-01/
Redirect 301 /blog-post-template.html /blog/_template/
